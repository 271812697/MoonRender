// Section face: the striped face of a section (the plane cut through a solid), with the same
// per-pixel edge feathering the topology faces use.
//
// Written in the material form MoonMatc consumes (see docs/ShaderPipeline.md), with all three
// stages written by this file - the generated skeletons cannot host any of them. The vertex
// stage builds the world normal with the inverse-transpose of the model matrix and carries a
// fourth attribute (the domain id) the skeleton has no varying for; the geometry stage insets
// each triangle and emits its edge equations; the fragment stage shades with those equations
// and with the section plane it is handed. MoonMatc puts the prelude, the variant #defines and
// the parameters in front of the blocks and generates nothing else.

material {
    name         : SectionFace,
    shadingModel : unlit,
    // No C++ draw site names this file any more, so the state is copied from the closest
    // sibling (GeomertySurface's transparent face material): the Transparents depth-peel body
    // it carries, culling off, depth still written.
    blending     : transparent,
    culling      : none,
    depthWrite   : true,

    features : [ WITH_EDGE ],
    passes   : [ Transparents ],

    parameters : [
        // The edge expansion reads the width in the geometry stage and feathers with it in
        // the fragment stage, so it is one parameter for both.
        { type : float,     name : lineWidth, default : 1.0 },
        { type : float3,    name : edgeColor },
        { type : float,     name : edgeOpacity, default : 1.0 },

        { type : sampler2D, name : u_AlbedoMap },
        { type : float4,    name : u_Albedo, default : vec4(1.0) },
        { type : sampler2D, name : u_NormalMap },
        { type : sampler2D, name : u_AmbientOcclusionMap },
        { type : sampler2D, name : u_MaskMap },

        { type : sampler2D, name : u_EmissiveMap },
        { type : float3,    name : u_EmissiveColor, default : vec3(1.0, 1.0, 1.0) },
        { type : float,     name : u_EmissiveIntensity, default : 0.0 },

        { type : float,     name : u_RefractionIndex, default : 1.5 },       // 1.0 = air, 1.33 = water, 1.5 = glass, etc.
        { type : float,     name : u_Transmission, default : 0.0 },          // 0.0 = opaque, 1.0 = fully transmissive
        { type : float2,    name : u_TextureTiling, default : vec2(1.0, 1.0) },
        { type : float2,    name : u_TextureOffset, default : vec2(0.0, 0.0) },

        { type : float,     name : u_AlphaClippingThreshold, default : 0.0 },
        { type : bool,      name : u_AlphaDithering, default : false },

        // Useful when no post-processing is applied.
        { type : bool,      name : u_BuiltInToneMapping, default : false },
        { type : bool,      name : u_BuiltInGammaCorrection, default : false },

        // The Transparents pass: the depth peel this material is drawn with.
        { type : sampler2D, name : DepthPeelTex },
        { type : sampler2D, name : OpaqueDepthTex },

        { type : sampler2D,   name : _ShadowMap },
        { type : mat4,        name : _LightSpaceMatrix },

        { type : samplerCube, name : _IrradianceCube },
        { type : samplerCube, name : _PrefilterCube },
        { type : sampler2D,   name : _BRDFLut },
        { type : float,       name : u_environmentIntensity, default : 0.5 },
        { type : sampler2D,   name : occlusionTex },

        // One colour per B-rep domain (declared by the old file, kept so that a draw site that
        // sets it keeps finding it).
        { type : samplerBuffer, name : domainColorTex },

        // The section plane and the stripe pattern the face is painted with.
        { type : float3,    name : lineNormal },
        { type : float3,    name : planeOrigin }
    ]
}

vertex {
layout (location = 0) in vec3 geo_Pos;
layout (location = 1) in vec2 geo_TexCoords;
layout (location = 2) in vec3 geo_Normal;
layout (location = 3) in vec2 geo_DomainId;

out VS_OUT
{
    vec3 FragPos;
    vec2 TexCoords;
    vec3 Normal;
    vec2 DomainId;
} vs_out;

void main()
{
    vec4 worldPos = ubo_Model * vec4(geo_Pos, 1.0);
    mat3 normalMatrix = mat3(transpose(inverse(ubo_Model)));
    vec3 worldNormal = normalize(normalMatrix * geo_Normal);
    vs_out.FragPos = worldPos.xyz;
    vs_out.TexCoords = geo_TexCoords;
    vs_out.Normal = worldNormal;
    vs_out.DomainId=geo_DomainId;    
    gl_Position = ubo_Projection * ubo_View * worldPos;
}
}

geometry {
in VS_OUT
{
    vec3 FragPos;
    vec2 TexCoords;
    vec3 Normal;
    vec2 DomainId;

}gs_in[];
out GS_OUT{
    vec3 FragPos;
    vec2 TexCoords;
    vec3 Normal;
    vec2 DomainId;
#if defined(WITH_EDGE)
    noperspective vec4 edgeEqn[3];
    float screenLengthOutput;
#endif
} gs_out;

layout(triangles) in;
layout(triangle_strip, max_vertices = 3) out;

// `lineWidth` is a material parameter now: it is read here to build the offsets and in the
// fragment stage to feather the edge.
//uniform samplerBuffer edgeTexture;
// surface with edges

void main() 
{

#if defined(WITH_EDGE)
    vec2 pos[4];
    for (int i = 0; i < 3; i++)
    {
        pos[i] = gl_in[i].gl_Position.xy/gl_in[i].gl_Position.w;
        pos[i] = pos[i]*vec2(0.5) + vec2(0.5);
        pos[i] = pos[i]*vec2(ubo_ScreenWidth,ubo_ScreenHeight);
    }
    pos[3] = pos[0];  

    float ccw = sign(cross(vec3(pos[1] - pos[0], 0.0), vec3(pos[2] - pos[0], 0.0)).z);

    for (int i = 0; i < 3; i++)
    {
        vec2 tmp = normalize(pos[i+1] - pos[i]);
        tmp = ccw*vec2(-tmp.y, tmp.x);
        float d = dot(pos[i], tmp);
        gs_out.edgeEqn[i] = vec4(tmp.x, tmp.y, 0.0, -d);
    }
    vec2 offsets[3];

    offsets[0] = gs_out.edgeEqn[2].xy + gs_out.edgeEqn[0].xy;
    offsets[0] = -0.5*normalize(offsets[0])*lineWidth;
    offsets[0] /= vec2(ubo_ScreenWidth,ubo_ScreenHeight);

    offsets[1] = gs_out.edgeEqn[0].xy + gs_out.edgeEqn[1].xy;
    offsets[1] = -0.5*normalize(offsets[1])*lineWidth;
    offsets[1] /= vec2(ubo_ScreenWidth,ubo_ScreenHeight);

    offsets[2] = gs_out.edgeEqn[1].xy + gs_out.edgeEqn[2].xy;
    offsets[2] = -0.5*normalize(offsets[2])*lineWidth;
    offsets[2] /= vec2(ubo_ScreenWidth,ubo_ScreenHeight);

    
    //float edgeValues = 255.0*texelFetch(edgeTexture, gl_PrimitiveIDIn + PrimitiveIDOffset).r;
    //if (edgeValues < 4.0) edgeEqn[2].z = lineWidth;
    //if (mod(edgeValues, 4.0) < 2.0) edgeEqn[1].z = lineWidth;
    //if (mod(edgeValues, 2.0) < 1.0) edgeEqn[0].z = lineWidth;


#endif
 

    vec3 nor=normalize(cross(gs_in[1].FragPos-gs_in[0].FragPos,gs_in[2].FragPos-gs_in[0].FragPos));      

    for (int i = 0; i < 3; i++)
    {
        gl_PrimitiveID = gl_PrimitiveIDIn;
#if defined(WITH_EDGE)
        gs_out.screenLengthOutput = length(pos[i + 1] - pos[i]);
#endif 
        gs_out.FragPos=gs_in[i].FragPos;
        gs_out.TexCoords=gs_in[i].TexCoords;
        gs_out.DomainId=gs_in[i].DomainId;
        gs_out.Normal=gs_in[i].Normal;
       
        gl_Position = gl_in[i].gl_Position;
#if defined(WITH_EDGE)
        gl_Position.xy = gl_Position.xy + offsets[i]*gl_Position.w;
#else
        gl_Position.xy = gl_Position.xy ;
#endif 

        EmitVertex();
    }
    EndPrimitive();
}
}

fragment {
#include ":Shaders/Lighting/PBR.ovfxh"

in GS_OUT
{
    vec3 FragPos;
    vec2 TexCoords;
    vec3 Normal;
    vec2 DomainId;
#if defined(WITH_EDGE)
    noperspective vec4 edgeEqn[3];
    float screenLengthOutput;
#endif
} fs_in;

// surface with edges
// `lineWidth`, `edgeColor` and `edgeOpacity` are material parameters now, so they are declared
// by MoonMatc in front of this block (the same holds for every other uniform that used to be
// declared here - see the parameters list above).

#define MATERIAL_HAS_NORMAL
#define HAS_ATTRIBUTE_TANGENTS
#define MIN_N_DOT_V 1e-4
#define MIN_PERCEPTUAL_ROUGHNESS 0.045
#define MIN_ROUGHNESS            0.002025
#define saturate(x)                 clamp(x, 0.0, 1.0)

float sq(float x) {
    return x * x;
}
float max3(const vec3 v) {
    return max(v.x, max(v.y, v.z));
}
float vmax(const vec2 v) {
    return max(v.x, v.y);
}
float vmax(const vec3 v) {
    return max(v.x, max(v.y, v.z));
}
float vmax(const vec4 v) {
    return max(max(v.x, v.y), max(v.z, v.w));
}
float min3(const vec3 v) {
    return min(v.x, min(v.y, v.z));
}
float vmin(const vec2 v) {
    return min(v.x, v.y);
}
float vmin(const vec3 v) {
    return min(v.x, min(v.y, v.z));
}
float vmin(const vec4 v) {
    return min(min(v.x, v.y), min(v.z, v.w));
}
#define MIN_N_DOT_V 1e-4
float clampNoV(float NoV) {
    return max(NoV, MIN_N_DOT_V);
}



// ----------------------------------------------------------------------------
vec3 fresnelSchlickRoughness(float cosTheta, vec3 F0, float roughness)
{
    return F0 + (max(vec3(1.0 - roughness), F0) - F0) * pow(clamp(1.0 - cosTheta, 0.0, 1.0), 5.0);
}   



out vec4 FRAGMENT_COLOR;

void main()
{
#if defined(Transparents)
  // Compare linear view-space depth instead of window depth. In an ortho
  // projection the whole [near, far] range is linearly compressed into [0, 1],
  // so close transparent layers can quantize to the same window depth and the
  // <= / >= comparisons swallow layers. Unprojecting both sides keeps the
  // peeling consistent in perspective and ortho.
  const mat4 invProj = inverse(ubo_Projection);
  ivec2 coords = ivec2(gl_FragCoord.xy);
  // Note: the unprojected vector is homogeneous (w != 1 in perspective), so
  // the view-space depth must be z / w. Taking .z alone yields a constant
  // (-1) in perspective and silently discards every peeled layer.
  // Reversed-Z: window depth is 1 at near and 0 at far, so the NDC conversion
  // flips (1 - 2 * raw) instead of (2 * raw - 1).
  vec4 unprojPrev = invProj * vec4(0.0, 0.0, 1.0 - texelFetch(DepthPeelTex, coords, 0).r * 2.0, 1.0);
  vec4 unprojOpaque = invProj * vec4(0.0, 0.0, 1.0 - texelFetch(OpaqueDepthTex, coords, 0).r * 2.0, 1.0);
  vec4 unprojFrag = invProj * vec4(0.0, 0.0, 1.0 - gl_FragCoord.z * 2.0, 1.0);
  float prevDepth = -unprojPrev.z / unprojPrev.w;
  float opaqueDepth = -unprojOpaque.z / unprojOpaque.w;
  float fragDepth = -unprojFrag.z / unprojFrag.w;
  if (fragDepth <= prevDepth || fragDepth >= opaqueDepth) discard;
#endif


    vec2 texCoords = TileAndOffsetTexCoords(fs_in.TexCoords, u_TextureTiling, u_TextureOffset);
    vec4 albedo = texture(u_AlbedoMap, texCoords) * u_Albedo;
    albedo.a *= texture(u_MaskMap, texCoords).r;
    if (albedo.a < u_AlphaClippingThreshold)
    {
        discard;
    }

    if (u_AlphaDithering && Dithering(albedo.a, gl_FragCoord.xy) < 0)
    {
        discard;
    }

    float stripePeriod=0.2f;
    float stripeBand=0.04f;
    float stripeBandS=0.02f;
    float fade=0.0;//clamp(length(ubo_ViewPos-fs_in.FragPos)/50.0,0,1);
    //circle
    //float dist=length(ubo_plane.xyz-fs_in.FragPos);
    vec3 offset=fs_in.FragPos-planeOrigin;
    float dist=dot(offset,lineNormal);
    float kth = floor(dist / stripePeriod);
    float center = kth * stripePeriod + stripePeriod * 0.5;
    float modDist = abs(dist - center);
    float t = smoothstep(stripeBandS, stripeBand, modDist);
    vec3 faceColor=albedo.rgb;
    albedo.rgb = mix(vec3(0,0,0), faceColor, t);
    albedo.rgb = mix(albedo.rgb,faceColor, fade);
    vec3 normal = normalize(fs_in.Normal);
  
    vec3 VD=normalize(ubo_ViewPos-fs_in.FragPos);
    if(ubo_CameraType==0){
       VD=vec3(ubo_View[0][2],ubo_View[1][2],ubo_View[2][2]);
    }
    if(dot(VD,normal)<0.0f){
        normal=-normal;
    }
    const float metallic =0;
    const float roughness = 1;
#if defined(WITH_EDGE)
    float edist[3];
    edist[0] = dot(fs_in.edgeEqn[0].xy, gl_FragCoord.xy) + fs_in.edgeEqn[0].w;
    edist[1] = dot(fs_in.edgeEqn[1].xy, gl_FragCoord.xy) + fs_in.edgeEqn[1].w;
    edist[2] = dot(fs_in.edgeEqn[2].xy, gl_FragCoord.xy) + fs_in.edgeEqn[2].w;
    if (edist[0] < -0.5 && fs_in.edgeEqn[0].z > 0.0) discard;
    if (edist[1] < -0.5 && fs_in.edgeEqn[1].z > 0.0) discard;
    if (edist[2] < -0.5 && fs_in.edgeEqn[2].z > 0.0) discard;
    edist[0] += fs_in.edgeEqn[0].z;
    edist[1] += fs_in.edgeEqn[1].z;
    edist[2] += fs_in.edgeEqn[2].z;
    float emix0 = clamp(0.5 + 0.5 * lineWidth - edist[0], 0.0, 1.0);
    float emix1 = clamp(0.5 + 0.5 * lineWidth - edist[1], 0.0, 1.0);
    float emix2 = clamp(0.5 + 0.5 * lineWidth - edist[2], 0.0, 1.0);
    float emix = emix1;
    emix = mix(emix, max(emix, emix0), step(fs_in.edgeEqn[0].z, 0.01));
    emix = mix(emix, max(emix, emix2), step(fs_in.edgeEqn[2].z, 0.01));
    float opacityFactor = clamp(fs_in.screenLengthOutput / 50., 0.15, 1.0);
    albedo.rgb = mix(albedo.rgb, edgeColor, emix*opacityFactor*edgeOpacity);
#endif
   vec3 pbr = PBRLighting(
        albedo.rgb,
        metallic,
        roughness,
        1.0,
        normal,
        VD,
        fs_in.FragPos,
        _ShadowMap,
        _LightSpaceMatrix,
        u_Transmission,
        u_RefractionIndex
    );

    // Simple built-in tonemapping (Reinhard) and gamma correction for elements
    // not affected by post-processing (e.g. debug, UI, etc.), but still aiming
    // to approximate the final PBR look.
    // The flag is broadcast with bvec3(): `mix(genType, genType, bool)` is not an overload the
    // GLSL 4.50 spec has (the boolean selector is the genBType one), so the old spelling only
    // compiled because the driver accepted it. Selecting per component is exactly what it did.
    pbr = mix(pbr, pbr / (pbr + vec3(1.0)), bvec3(u_BuiltInToneMapping));
    pbr = mix(pbr, pow(pbr, vec3(1.0 / 2.2)), bvec3(u_BuiltInGammaCorrection));

    // Albedo textures are stored as sRGB (RGBA8, no hardware decode), so decode to
    // linear before using it for IBL, matching PBRLighting()'s internal handling.
    const vec3 linearAlbedo = pow(albedo.rgb, vec3(2.2));
    vec3 F0 = vec3(0.04); 
    F0 = mix(F0, linearAlbedo, metallic);
    vec3 F = fresnelSchlickRoughness(max(dot(normal, VD), 0.0), F0, roughness);
    vec3 kS = F;
    vec3 kD = 1.0 - kS;
    kD *= 1.0 - metallic;	

    vec3 irradiance = texture(_IrradianceCube, normal).rgb;
    vec3 diffuse      = irradiance * linearAlbedo;
    
    // sample both the pre-filter map and the BRDF lut and combine them together as per the Split-Sum approximation to get the IBL specular part.
    const float MAX_REFLECTION_LOD = float(textureQueryLevels(_PrefilterCube) - 1);
    vec3 R = reflect(-VD, normal); 
    vec3 prefilteredColor = textureLod(_PrefilterCube, R,  roughness * MAX_REFLECTION_LOD).rgb;    
    vec2 brdf  = texture(_BRDFLut, vec2(max(dot(normal, VD), 0.0), roughness)).rg;
    vec3 sp = prefilteredColor * (F * brdf.x + brdf.y);

    vec3 iblColor = (kD * diffuse+sp) *u_environmentIntensity;


 
    const vec3 emissive = texture(u_EmissiveMap, texCoords).rgb * u_EmissiveColor * u_EmissiveIntensity;
    pbr += emissive+iblColor;
    //pbr=iblColor;
    //pbr=diffuse;
    FRAGMENT_COLOR = vec4(pbr,albedo.a);

}
}
